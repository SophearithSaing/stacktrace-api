# Copy to .env and explicitly source it as described in README.md.
APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
API_PUBLIC_ORIGIN=http://localhost:8080
CLIENT_ORIGINS=http://localhost:5173
# Generate with openssl rand -hex 32; required by the server in every mode.
CSRF_SIGNING_KEY=
# Generate a separate value with openssl rand -hex 32; required by the server.
CURSOR_SIGNING_KEY=

# Set a locally generated password before starting Compose.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Set a PostgreSQL URL including credentials in your shell or local .env.
# See README.md for a command that constructs it from POSTGRES_PASSWORD.
DATABASE_URL=
