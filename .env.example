# For direct application execution only. `make dev-up` manages its own settings
# under .dev/ and does not load this file or deployment credentials.
# Go commands read the process environment; source a private copy explicitly.
APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
API_PUBLIC_ORIGIN=http://localhost:8080
CLIENT_ORIGINS=http://localhost:5173
# Generate with openssl rand -hex 32; required by the server in every mode.
CSRF_SIGNING_KEY=
# Generate a separate value with openssl rand -hex 32; required by the server.
CURSOR_SIGNING_KEY=

# For manual Compose use only; the managed runner supplies its own password.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Set a PostgreSQL URL including credentials in your shell or local .env.
# Example shape: postgres://stacktrace:PASSWORD@localhost:5432/stacktrace?sslmode=disable
DATABASE_URL=

# Only `go run ./cmd/worker execute` and `serve` read this key. They perform
# bounded paid generation passes; check, schedule, server and db never access the
# provider key. Keep unset for ordinary tests and smoke checks, which use fake
# providers only.
TOGETHER_API_KEY=

# Infrastructure listener for `go run ./cmd/worker serve`. Defaults to
# 127.0.0.1:8081 and exposes only /healthz and /readyz.
WORKER_HTTP_ADDR=127.0.0.1:8081
