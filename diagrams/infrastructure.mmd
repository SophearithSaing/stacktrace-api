flowchart LR
    client["Separate frontend origin<br/>for example app.example.com"]
    ingress["TLS proxy / Cloud Run ingress<br/>for example api.example.com"]
    provider["Together AI REST API"]

    subgraph backend["Cloud Run target deployment — templates; not provisioned"]
        api["Cloud Run API service<br/>cmd/server; request-based CPU<br/>API /healthz + DB/schema /readyz"]
        worker["Private Cloud Run worker service<br/>cmd/worker serve; always-allocated CPU<br/>minimum 1; loop /healthz + cycle/DB /readyz"]

        subgraph api_layers["API process boundaries"]
            middleware["Middleware<br/>CORS, sessions, CSRF,<br/>limits, logging, recovery"]
            handlers["HTTP handlers<br/>internal/api"]
            domain["Domain rules<br/>internal/app"]
            api_store["SQL store<br/>internal/postgres"]
            middleware --> handlers
            handlers -->|"Domain validation"| domain
            handlers -->|"Persistence operations"| api_store
        end

        subgraph worker_layers["Worker process boundaries"]
            scheduler["Schedule and expire<br/>bounded jobs"]
            executor["Claim, lease, validate,<br/>settle, and publish"]
            llm["Together adapter<br/>internal/llm"]
            worker_store["SQL store<br/>internal/postgres"]
            scheduler --> worker_store
            executor --> worker_store
            executor --> llm
        end

        api --> middleware
        worker --> scheduler
        worker --> executor
    end

    subgraph operations["Explicit trusted operations"]
        migrate["Explicit migration Job<br/>cmd/db migrate; never startup seeding"]
        admin["Restricted operator Job<br/>cmd/admin; status by default"]
        diagnostics["Private development terminal<br/>execute --provider-diagnostics<br/>HTTP errors + bounded adapter rejection metadata"]
    end

    database[("Neon PostgreSQL<br/>social data + sessions<br/>durable generation queue<br/>migration history")]
    secrets["Secret Manager<br/>versioned role-scoped secrets"]
    image["One non-root release image<br/>Artifact Registry digest<br/>server, worker, db, admin"]

    client -->|"Credentialed HTTPS API<br/>CORS + cookie + CSRF on writes"| ingress
    ingress --> api
    api_store -->|"Pooled PostgreSQL/TLS<br/>parameterized SQL; short transactions"| database
    worker_store -->|"Pooled PostgreSQL/TLS<br/>claims, reservations, publication"| database
    llm -->|"Outbound HTTPS<br/>worker credentials only"| provider
    migrate -.->|"Direct PostgreSQL/TLS<br/>explicit migration; advisory lock"| database
    admin -.->|"Direct PostgreSQL/TLS<br/>trusted policy, pause, retry, removal"| database
    image -.->|"Separate service commands"| api
    image -.-> worker
    image -.->|"Explicit release / operator commands"| migrate
    image -.-> admin
    secrets -.->|"DB URL + CSRF/cursor keys"| api
    secrets -.->|"DB URL + Together key"| worker
    secrets -.->|"Separate privileged DB URLs"| migrate
    secrets -.-> admin
    llm -.->|"Opt-in only; no provider text<br/>in API, database, or retained logs"| diagnostics

    classDef external fill:#f5f5f5,stroke:#666,color:#111
    classDef process fill:#e8f1ff,stroke:#3568a8,color:#111
    classDef storage fill:#fff2cc,stroke:#a67c00,color:#111
    class client,ingress,provider,secrets,image external
    class api,worker,middleware,handlers,domain,api_store,scheduler,executor,llm,worker_store,migrate,admin process
    class database storage
